@page "/GestionLibros/Index"
@inject LibroService libroService
@inject ToastService toastService

<PageTitle>Index</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de Libros</h5>
            <a href ="/GestionLibros/Crear" class="btn btn-primary"><span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">

                @*filtar*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*valor filtro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value=""selected disabled>Elija una opci&oacute;n</option>
                        <option value="Titulo">T&iacute;tulo</option>
                        <option value="Autor">Autor</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

           <div class="grid mt-2">
               <QuickGrid Items="@itemsQueryable">
                   <PropertyColumn Property="@(l => l.LibroId)" Sortable = "true" />
                   <PropertyColumn Property="@(l => l.Titulo)" Sortable = "true" />
                   <PropertyColumn Property="@(l => l.Autor)" Sortable = "true" />
                   <PropertyColumn Property="@(l => l.AnoPublicacion)" Sortable = "true" />
                   <PropertyColumn Property="@(l => l.Disponible)" Sortable = "true" />

                   <TemplateColumn Title="Opciones">
                        <a href="/GestionLibros/Modificar/@context.LibroId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                        <a href="/GestionLibros/Eliminar/@context.LibroId" class="btn btn-outline-danger bi bi-trash"></a>
                   </TemplateColumn>
               </QuickGrid>
           </div>

        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label class="ms-3"><strong>Cantidad: </strong>@itemsQueryable?.Count()</label>
        </div>
    </div>
</div>

@code {

    IQueryable<Libros?> itemsQueryable;

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var items = await libroService.GetList(l => l.LibroId > 0);
        itemsQueryable = items.AsQueryable();
    }

    private async Task Buscar()
    {
        if(ValorFiltro.Trim() !="" && Filtro == "Autor")
        {
            var Autor = await libroService.GetList(l => l.Autor.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Autor.AsQueryable();

        }else if (ValorFiltro.Trim() !="" && Filtro == "Titulo")
        {
            var Titulo = await libroService.GetList(l => l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Titulo.AsQueryable();
        }
    }
}
