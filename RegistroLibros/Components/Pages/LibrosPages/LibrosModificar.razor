@page "/GestionLibros/Modificar/{LibroId:int}"
@inject LibroService libroService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Modificar libro</PageTitle>
<EditForm Model="libro" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class ="card shadow-lg">
        <div class="card-header text-center">
            <h5 class ="card-title">Modificar Libro</h5>
        </div>

        <div class = "card-body">
             @*LibroId*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>LibroId</strong></label>
                    <InputNumber class = "form-control" @bind-Value="libro.LibroId" readonly></InputNumber>
                </div>

                @*Titulo*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>T&iacute;tulo</strong></label>
                    <InputText class ="form-control" @bind-Value="libro.Titulo"></InputText>
                    <ValidationMessage For="(() => libro.Titulo)"/>
                </div>

                @*Autor*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>Autor</strong></label>
                    <InputText class ="form-control" @bind-Value="libro.Autor"></InputText>
                    <ValidationMessage For="(() => libro.Autor)"/>
                </div>

                @*Anio*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>A&ntilde;o Publicaci&oacute;n</strong></label>
                    <InputNumber class = "form-control" @bind-Value="libro.AnoPublicacion" ></InputNumber>
                </div>
        </div>
        @*footer*@
        <div class ="card-footer text-center mt-2">
            <a href="/GestionLibros/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <a href="" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</a>
        </div>
        </div>
    </div>
</EditForm>


@*Modal eliminacion*@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (libro != null)
                {

                    <p>¿Esta seguro que desea eliminar este libro?</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Eliminar">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int LibroId{ get; set; }
    public Libros libro { get; set; } = new Libros();

    protected override async Task OnInitializedAsync()
    {
        libro = await libroService.Buscar(LibroId);
    }

    public async Task Modificar()
    {
        var creado = await libroService.Guardar(libro);
        if (creado)
        {
            toastService.ShowSuccess("¡Libro modificado exitosamente!");
            navigationManager.NavigateTo("/GestionLibros/Index");
        }
        else
        {
            toastService.ShowError("El libro no se ha podido modificar.");   
        }
    }

    private async Task Eliminar()
    {
        var eliminado = await libroService.Eliminar(libro.LibroId);

        if (eliminado)
        {
            toastService.ShowSuccess("¡Se ha eliminado el libro exitosamente!");   
            navigationManager.NavigateTo("/GestionLibros/Index");
        }else
        {
            toastService.ShowError("El libro no se ha podido eliminar.");   
        }
    }
}
