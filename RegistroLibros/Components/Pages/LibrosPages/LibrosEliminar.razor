@page "/GestionLibros/Eliminar/{LibroId:int}"
@inject LibroService libroService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Eliminar</PageTitle>
<div class="container">
    <div class ="card shadow-lg">
        @*Header*@
        <div class = "card-header text-center">
            <h5><strong>Datos del Libro</strong></h5>
        </div>

        @*Body*@
        <div class="card-body">
            <h5><strong>¿Desea eliminar este libro?</strong></h5>
        </div>

        <ul class ="mt-4">
            <li><strong>LibroId:</strong>@libro.LibroId</li>
            <li><strong>T&iacute;tulo: </strong>@libro.Titulo</li>
            <li><strong>Autor: </strong>@libro.Autor</li>
            <li><strong>A&ntilde;o Publicaci&oacute;n: </strong>@libro.AnoPublicacion</li>
        </ul>

        @*footer*@
        <div class="card-footer text-center">
            <a href ="/GestionLibros/Index" class ="btn btn-primary"> <span class = "bi bi-arrow-left"></span>Volver</a>
            <button type="button" class ="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</button>
        </div>
    </div>
</div>

@*Modal eliminacion*@
<div class = "modal" id="modalEliminar" tabindex="-1" role ="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class ="modal-header">
                <h5 class ="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                <button type ="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class ="modal-body">
                @if(libro != null){

                    <p>¿Esta seguro que desea eliminar este estudiante?</p>
                }
            </div>
            <div class="modal-footer">
                <button type = "button" class ="btn btn-primary" @onclick="Eliminar">Confirmar</button>
                <button type="button" class ="btn btn-secondary" data-bs-dismiss ="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int LibroId{ get; set; }
    public Libros libro { get; set; } = new Libros();

    protected override async Task OnInitializedAsync()
    {
        libro = await libroService.Buscar(LibroId);
    }

    public async Task Eliminar(){

        var eliminado = await libroService.Eliminar(libro.LibroId);

        if(eliminado){
            toastService.ShowSuccess("¡Libro eliminado correctamente!");
            navigationManager.NavigateTo("/GestionLibros/Index");
        }else{
            toastService.ShowError("No se ha podido eliminar el libro.");
        }
    }
}
