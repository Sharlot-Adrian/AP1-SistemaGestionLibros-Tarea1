@page "/GestionLibros/Index"
@inject LibroService libroService
@using RegistroLibros.Extentors
@inject ToastService toastService

<PageTitle>Index de Libros</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de Libros</h5>
            <a href ="/GestionLibros/Crear" class="btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span> Crear
            </a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">

                @*filtar*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*valor filtro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>

                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value=""selected disabled>Elija una opci&oacute;n</option>
                        <option value="Titulo">T&iacute;tulo</option>
                        <option value="Autor">Autor</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                @*Restablecer*@
                <div class="col-3">
                    <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise"
                    @onclick="Restablecer">
                </button>
                </div>
            </div>
            <table class="table table-hover text-center mt-3">
                <thead class="table table-striped text-black ">
                    <tr>
                        <th>LibroId</th>
                        <th>T&iacute;tulo</th>
                        <th>Autor</th>
                        <th>A&ntilde;o Publicaci&oacute;n</th>
                        <th>Opciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach(var libro in ListaLibros)
                    {
                        <tr>
                            <td>@libro.LibroId</td>
                            <td>@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td>@libro.AnoPublicacion</td>

                            <td class="text-center">
                                <a href="/GestionLibros/Modificar/@libro.LibroId"
                                class="btn btn-outline-primary bi bi-pencil-square"></a>
                                <a href="/GestionLibros/Eliminar/@libro.LibroId" class="btn btn-outline-danger bi bi-trash"></a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label class="ms-3"><strong>Cantidad: </strong>@ListaLibros.Count</label>

        </div>
    </div>
</div>

@code {

    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await libroService.GetList(l => l.LibroId > 0);
    }

    private async Task Buscar()
    {
        if(ValorFiltro.Trim() !="" && Filtro == "Autor")
        {
            ListaLibros = await libroService.GetList(l => l.Autor.ToLower().Contains(ValorFiltro.ToLower()));

        }else if (ValorFiltro.Trim() !="" && Filtro == "Titulo")
        {
            ListaLibros = await libroService.GetList(l => l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
        }


    }

    private async Task Restablecer()
    {
        ListaLibros = await libroService.GetList(e => e.LibroId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
}
