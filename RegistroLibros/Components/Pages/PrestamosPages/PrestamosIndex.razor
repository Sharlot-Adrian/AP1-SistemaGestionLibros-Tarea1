@page "/Prestamo/Index"

@inject PrestamosService prestamosService

<PageTitle> Registo de Prestamos</PageTitle>
<div class = "container">
    <div class =  "card shadow-lg">
        <div class = "card-header d-flex justify-content-between align-content-center mb-4">
        <h5 class = "card-title">
            Registro de Prestamos
        </h5>
        <a href = "/Prestamo/Create" class = "btn btn-primary"><span class = "bi bi-plus-square mt-3"></span> Crear</a
    </div>

    <div class =  "card-body">
        @*Labels*@
        <div class = "row">

            @*Filtrar Por*@
            <div class = "col-3">
                <label class = "col-form-label"><strong>Filtrar por</strong></label>
            </div>

            @*ValorFiltro*@
            <div class ="col-4">
                <label class = "col-form-label"><strong>B&uacute;squeda</strong></label>
            </div>
        </div>

        @*inputs y botones*@
        <div class = "row align-items-center">
            @*Filtro*@
            <div class = "col-3">
                <InputSelect class = "form-select" @bind-Value = "Filtro">
                    <option value = "" selected disables> Elija una opci&oacute;n</option>
                    <option value = "Estudiante">Estudiante</option>
                    <option value = "Titulo">Titulo</option>
                </InputSelect>
            </div>

            @*Busqueda*@
            <div class = "col-4">
                <div class = "input-group">
                    <input class = "form-control" @bind = "ValorFiltro" placeholder = "Buscar" />
                    <button type = "button" class = "btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                </div>
            </div>

        </div>

        <div class = "grid mt-2">
            <QuickGrid Items = "@itemsQueryable">
                <PropertyColumn Property = "@(p => p.PrestamoId)" Sortable = "true" />
                <PropertyColumn Property = "@(p => p.LibroId)" Sortable = "true" />
                <PropertyColumn Property = "@(p => p.Libro.Titulo)" Sortable = "true" />
                <PropertyColumn Property = "@(p => p.EstudianteId)" Sortable = "true" />
                <PropertyColumn Property = "@(p => p.Estudiante.Nombres)" Sortable = "true" />

                <TemplateColumn Title = "Opciones">
                     <a href="/Prestamo/Edit/@context.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                     @*<a href="/Presamo/Eliminar/@context.EstudianteId" class="btn btn-outline-danger bi bi-trash"></a>*@
                </TemplateColumn>
            </QuickGrid>
        </div>
    </div>
    <div class = "card-footer d-flex justify-content-between align-center mb-4">
        <label>Cantidad: @itemsQueryable?.Count()</label>
    </div>
    </div>
</div>
@code {
    IQueryable<Prestamos?> itemsQueryable;
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var items = await prestamosService.GetList(p => p.PrestamoId > 0);
        itemsQueryable = items.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Estudiante")
            {
                var Estudiante = await prestamosService.GetList(p => p.Estudiante.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
                itemsQueryable = Estudiante.AsQueryable();
            }
            else if (Filtro == "Titulo")
            {
                var Titulo = await prestamosService.GetList(p => p.Libro.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
                itemsQueryable = Titulo.AsQueryable();
            }
        }
        else
        {
            var items = await prestamosService.GetList(p => p.PrestamoId > 0);
            itemsQueryable = items.AsQueryable();
        }
    }

    private async Task Restablecer()
    {
        var items = await prestamosService.GetList(e => e.PrestamoId > 0);
        itemsQueryable = items.AsQueryable();
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }


}
