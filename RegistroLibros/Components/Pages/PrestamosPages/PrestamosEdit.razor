@page "/Prestamo/Edit/{PrestamoId:int}"
@inject PrestamosService prestamosService
@inject EstudiantesService estudiantesService
@inject LibroService libroService
@inject ToastService toastService
@inject NavigationManager navigationManager

@*HTML*@
<PageTitle> Modificar</PageTitle>
<EditForm Model ="Prestamo" OnValidSubmit ="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class ="container">
        <div class ="card shadow-lg">
            <div class ="card-header text-center">
                <h5 class ="card-title">Modificar Prestamo</h5>
            </div>

            <div class ="card-body">

             @*Estudiante*@
                <div class ="mb-3">
                    <label class ="form-label"><strong> Estudiante</strong></label>
                    <InputSelect class ="form-control form-select" @bind-Value = "Prestamo.EstudianteId">
                        <option>Elija una opci&oacute;n</option>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value ="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @*Libros*@
                <div class ="mb-3">
                    <label class ="form-label"><strong> Libro</strong></label>
                    <InputSelect class ="form-control form-select" @bind-Value = "Prestamo.LibroId">
                        <option>Elija una opci&oacute;n</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value ="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>
        </div>
        
        @*footer*@
        <div class ="card-footer text-center mt-2">
            <a href ="/Prestamo/Index" class ="btn btn-secondary">
                <span class ="bi bi-arrow-left"></span> Volver
            </a>

            <button type ="submit" class ="btn btn-primary bi bi-floppy">Modificar</button>
            <button type ="button" class ="btn btn-danger bi bi-trash" @onclick =" Eliminar"> Eliminar</button>
        </div>
    </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int PrestamoId { get; set; }
    public Prestamos Prestamo { get; set; } = new Prestamos();
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        Prestamo = await prestamosService.Buscar(PrestamoId);
        ListaEstudiantes = await estudiantesService.GetList(e => e.EstudianteId > 0); 
        ListaLibros = await libroService.GetList(l => l.LibroId > 0); 
    }

    public async Task Modificar()
    {
        var creado = await prestamosService.Guardar(Prestamo);

        if (creado)
        {
            toastService.ShowSuccess("¡Se ha modificado correctamente el prestamo!");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se ha podido modificar el prestamo.");
        }
    }

    public async Task Eliminar()
    {
        var eliminado = await prestamosService.Eliminar(Prestamo.PrestamoId);

        if (eliminado)
        {
            toastService.ShowSuccess("¡Se ha eliminado correctamente el prestamo!");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se ha podido eliminar el prestamo.");
        }
    }
}
