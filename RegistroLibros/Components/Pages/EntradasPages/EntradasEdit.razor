@page "/Entradas/Modificar/{EntradaId:int}"

@inject EntradasService entradasService
@inject LibroService libroService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Crear Entradas</PageTitle>
<EditForm Model = "Entrada" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class = "container">
        <div class = "card shadow-lg">
            <div class = "card-header text-center">
                <h5 class = "card-title">Crear Entrada</h5>
            </div>
            
    <div class = "card-body">

         <div class="d-flex justify-content-center gap-3">
            @*Fecha*@
            <div class="mb-3" style="width: 200px;">
                 <label class="form-label"><strong>Fecha</strong></label>
                 <InputDate class="form-control" @bind-Value="Entrada.Fecha"></InputDate>
            </div>
            @*Total*@
            <div class="mb-3" style="width: 200px;">
                 <label class="form-label"><strong>Total</strong></label>
                 <InputNumber class="form-control" @bind-Value="Entrada.Total"></InputNumber>
            </div>
        </div>
            @*Id*@
            <div class = "mb-3">
                <label class = "form-label"><strong>EntradaId</strong></label>
                <InputNumber class = "form-control" @bind-Value = "Entrada.EntradaId" readonly></InputNumber>
            </div>
            @*Concepto*@
            <div class = "mb-3">
                <label class = "form-label"><strong>Concepto</strong></label>
                <InputText class = "form-control" @bind-Value = "Entrada.Concepto"></InputText>
            </div>

            @*detalle de entrada*@

            <div class = "border border-success p-3 mt-3">
                <h5>Detalles de la Entrada</h5>

                <LibroPicker Libros = "ListaLibros"
                             LibroId = "DetalleSeleccionado.LibroId"
                             Cantidad = "DetalleSeleccionado.Cantidad"
                             OnLibroSelected = "HandleLibroSelected" />
                <hr />
                <div class = "grid mt-2">
                    <QuickGrid Items = "Entrada.EntradasDetalle.AsQueryable()" class = "table table-light table-hover text-center">
                        <PropertyColumn Property = "l => l.LibroId" Sortable = "true"> </PropertyColumn>

                        <TemplateColumn Title = "Libro" Context = "detalle">
                            @(detalle.Libro != null ? detalle.Libro.Titulo : $"Libro: {detalle.LibroId}")
                        </TemplateColumn>

                        <PropertyColumn Property = "d => d.Cantidad" Sortable = "true"></PropertyColumn>
                        <TemplateColumn Title = "Remover" Context = "detalle">
                            <button type = "button" class = "btn btn-outline-danger bi bi-trash" @onclick = "() => RemoverDetalle(detalle)"></button>
                        </TemplateColumn>
                    </QuickGrid>
                </div>
            </div>

            @*footer*@
            <div class = "card-footer text-center mt-2">
                <a href = "/Entradas/Index" class = "btn btn-secondary"><span class = "bi bi-arrow-left"></span> Volver</a>
                <button type = "submit" class = "btn btn-primary bi bi-floppy"> Modificar</button>
                <button type = "button" class = "btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</button>
            </div>

    </div>
        </div>
    </div>
</EditForm>

    @*Modal eliminacion*@
    <div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
         <div class="modal-dialog" role="document">
           <div class="modal-content">
             <div class="modal-header">
                   <h5 class="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                   <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                   @if (Entrada != null)
                    {
                      <p>¿Esta seguro que desea eliminar a esta entrada?</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="Eliminar" data-bs-dismiss ="modal">Confirmar</button>
                     <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
           </div>
        </div>
    </div>

@code {

    [Parameter]
    public int EntradaId { get; set; }
    public Entradas Entrada = new Entradas();
    public List<Libros> ListaLibros { get; set; } = [];
    public EntradasDetalle DetalleSeleccionado { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await libroService.GetList(l => l.LibroId > 0);
        if (result != null && result.IsSuccess)
        {
            ListaLibros = result.Value;
        }
        Entrada.Fecha = DateTime.Now;

        var entrada = await entradasService.Buscar(EntradaId) ?? new Entradas();
        if (entrada != null && entrada.IsSuccess)
        {
            Entrada = entrada.Value;
        }
    }

    private async Task HandleLibroSelected((Libros libro, int cantidad) selection)
    {
        var yaExiste = Entrada.EntradasDetalle.Any(l => l.LibroId == selection.libro.LibroId);

        if (yaExiste)
        {
            toastService.ShowError("El libro ya existe en los detalles.");
            return;
        }

        var detalle = new EntradasDetalle
        {
            LibroId = selection.libro.LibroId,
            Cantidad = selection.cantidad,
            Libro = selection.libro
        };

        Entrada.EntradasDetalle.Add(detalle);
        Entrada.Total = Entrada.EntradasDetalle.Sum(t => t.Cantidad);
        DetalleSeleccionado = new EntradasDetalle();

        await Task.CompletedTask;
    }

    public async Task Modificar()
    {
        var result = await entradasService.Guardar(Entrada);

        if (result.IsSuccess)
        {
            toastService.ShowSuccess("Entrada modificada Exitosamente!");
            navigationManager.NavigateTo("/Entradas/Index");
        }
        else
        {
            toastService.ShowError("No se pudo guardar la entrada correctamente.");
        }
    }

    public void RemoverDetalle(EntradasDetalle detalle)
    {
        var result = Entrada.EntradasDetalle.Remove(detalle);
        Entrada.Total = Entrada.EntradasDetalle.Sum(t => t.Cantidad);
        DetalleSeleccionado = detalle;

        if (result)
        {
            toastService.ShowSuccess("Entrada Eliminada Exitosamente!");
            navigationManager.NavigateTo("/Entradas/Index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar la entrada correctamente.");
        }
    }

     private async Task Eliminar()
 {
     var result = await entradasService.Eliminar(Entrada.EntradaId);

     result.OnSuccess(() =>
     {
         toastService.ShowSuccess("¡Se ha eliminado la entrada exitosamente!");   
         navigationManager.NavigateTo("/Entradas/Index");
     });

     result.OnFailure(() => toastService.ShowError("No se ha podido eliminar la entrada."));
 }
}
