@page "/GestionEstudiantes/Index"
@inject EstudiantesService estudianteService
@inject ToastService toastService

<PageTitle>Index</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de Estudiantes</h5>
            <a href="GestionEstudiantes/Crear" class=" btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span> Crear
            </a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">

                @*filtar*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*valor filtro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>

                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Email">Email</option>
                        
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                @*Restablecer*@
                <div class="col-3">
                    <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise"
                            @onclick="Restablecer">
                    </button>
                </div>
            </div>
            <table class="table table-hover text-center mt-3">
                <thead class="table table-striped text-black ">
                    <tr>
                        <th>EstudianteId</th>
                        <th>Nombres</th>
                        <th>Direccion</th>
                        <th>Email</th>
                        <th>Fecha de Nacimiento</th>
                        <th>Opciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var estudiante in ListaEstudiantes)
                    {
                        <tr>
                            <td>@estudiante.EstudianteId</td>
                            <td>@estudiante.Nombres</td>
                            <td>@estudiante.Direccion</td>
                            <td>@estudiante.Email</td>
                            <td>@estudiante.FechaNacimiento.ToString("dd/MM/yy")</td>

                            <td class="text-center">
                                <a href="/GestionEstudiantes/Modificar/@estudiante.EstudianteId"
                                   class="btn btn-outline-primary bi bi-pencil-square"></a>
                                <a href="/GestionEstudiantes/Eliminar/@estudiante.EstudianteId" class="btn btn-outline-danger bi bi-trash"></a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label class="ms-3"><strong>Cantidad: </strong>@ListaEstudiantes.Count</label>

        </div>
    </div>
</div>

@code {

    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudianteService.GetList(e => e.EstudianteId > 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "" && Filtro == "Nombres")
        {
            ListaEstudiantes = await estudianteService.GetList(e => e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));

        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Email")
        {
            ListaEstudiantes = await estudianteService.GetList(e => e.Email.ToLower().Contains(ValorFiltro.ToLower()));
        }


    }

    private async Task Restablecer()
    {
        ListaEstudiantes = await estudianteService.GetList(e => e.EstudianteId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
}
