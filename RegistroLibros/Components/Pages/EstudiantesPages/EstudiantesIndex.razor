@page "/GestionEstudiantes/Index"
@using Microsoft.AspNetCore.Components.QuickGrid
@inject EstudiantesService estudianteService
@inject ToastService toastService

<PageTitle>Index</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Registro de Estudiantes</h5>
            <a href="GestionEstudiantes/Crear" class=" btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span> Crear
            </a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">

                @*filtar*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*valor filtro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>

                </div>
            </div>

            @*inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Nombres">Nombres</option>
                        <option value="Email">Email</option>
                        
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                @*Restablecer*@
                <div class="col-3">
                    <button type="button" class="btn btn-outline-secondary bi bi-arrow-counterclockwise"
                            @onclick="Restablecer">
                    </button>
                </div>
            </div>
            
            <div class="grid mt-2">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property = "@(e => e.EstudianteId)" Sortable = "true" />
                    <PropertyColumn Property = "@(e => e.Nombres)" Sortable = "true" />
                    <PropertyColumn Property = "@(e => e.Direccion)" Sortable = "true" />
                    <PropertyColumn Property = "@(e => e.Email)" Sortable = "true" />
                    <PropertyColumn Property = "@(e => e.FechaNacimiento)" Format = "dd/MM/yy" Sortable = "true" />

                    <TemplateColumn Title="Opciones">
                    <a href="/GestionEstudiantes/Modificar/@context.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                    <a href="/GestionEstudiantes/Eliminar/@context.EstudianteId" class="btn btn-outline-danger bi bi-trash"></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>

        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label class="ms-3"><strong>Cantidad: </strong>@itemsQueryable?.Count()</label>

        </div>
    </div>
</div>

@code {

    IQueryable<Estudiantes?> itemsQueryable;

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var items = await estudianteService.GetList(e => e.EstudianteId > 0);
        itemsQueryable = items.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "" && Filtro == "Nombres")
        {
            var nombres = await estudianteService.GetList(e => e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = nombres.AsQueryable();

        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Email")
        {
            var email = await estudianteService.GetList(e => e.Email.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = email.AsQueryable();
        }


    }

    private async Task Restablecer()
    {
        var items = await estudianteService.GetList(e => e.EstudianteId > 0);
        itemsQueryable = items.AsQueryable();
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
}
