@page "/GestionEstudiantes/Modificar/{EstudianteId:int}"
@inject EstudiantesService estudiantesService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Modificar Estudiante</PageTitle>
<EditForm Model="estudiante" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card-header text-center">
            <h5 class ="card-title">Modificar Estudiante</h5>
        </div>

        <div class = "card-body">
             @*EstudianteId*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>EstudianteId</strong></label>
                    <InputNumber class = "form-control" @bind-Value="estudiante.EstudianteId" readonly></InputNumber>
                </div>

                @*Nombres*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>Nombres</strong></label>
                    <InputText class ="form-control" @bind-Value="estudiante.Nombres"></InputText>
                    <ValidationMessage For="(() => estudiante.Nombres)"/>
                </div>

                @*Direccion*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>Direccion</strong></label>
                    <InputText class ="form-control" @bind-Value="estudiante.Direccion"></InputText>
                    <ValidationMessage For="(() => estudiante.Direccion)"/>
                </div>

                @*Nombres*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>E-mail</strong></label>
                    <InputText class ="form-control" @bind-Value="estudiante.Email"></InputText>
                    <ValidationMessage For="(() => estudiante.Email)"/>
                </div>

                @*FechaNacimiento*@
                <div class = "mb-3">
                    <label class = "form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate class = "form-control" @bind-Value="estudiante.FechaNacimiento" ></InputDate>
                    <ValidationMessage For="(() => estudiante.FechaNacimiento)"/>
                </div>
        </div>
        @*footer*@
        <div class ="card-footer text-center mt-2">
            <a href="/GestionEstudiantes/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <a href="" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</a>
        </div>
    </div>
</EditForm>

@*Modal eliminacion*@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (estudiante != null)
                {

                    <p>¿Esta seguro que desea eliminar a este estudiante?</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Eliminar">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public int EstudianteId{ get; set; }
    public Estudiantes estudiante { get; set; } = new Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        estudiante = await estudiantesService.Buscar(EstudianteId);
    }

    public async Task Modificar()
    {
        var creado = await estudiantesService.Guardar(estudiante);
        if (creado)
        {
            toastService.ShowSuccess("¡Estudiante modificado exitosamente!");
            navigationManager.NavigateTo("/GestionEstudiantes/Index");
        }
        else
        {
            toastService.ShowError("No se ha podido modificar al estudiante.");   
        }
    }

    private async Task Eliminar()
    {
        var eliminado = await estudiantesService.Eliminar(estudiante.EstudianteId);

        if (eliminado)
        {
            toastService.ShowSuccess("¡Se ha eliminado el estudiante exitosamente!");   
        }else
        {
            toastService.ShowError("No se ha podido eliminar al estudiante.");   
        }
    }

}
